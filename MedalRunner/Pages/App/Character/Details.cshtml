                    <img class="item-slot" src="@SlotImg((int)Item.GearSlot.Legs, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/legs.png")" alt="Legs" />
                </a>
                @* Feet (slot 10) *@
                <a asp-page="/App/Character/Change" asp-route-characterId="@charId" asp-route-slot="@((int)Item.GearSlot.Feet)" asp-route-itemId="@SlotId((int)Item.GearSlot.Feet)">
                    <img class="item-slot" src="@SlotImg((int)Item.GearSlot.Feet, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Feet" />
                </a>
            </div>
            <div class="two-slots">
                @* Ring1 (slot 11) *@
