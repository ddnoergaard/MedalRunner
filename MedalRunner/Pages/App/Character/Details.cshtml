@page "{id:int}"
@model MedalRunner.Pages.App.Character.DetailsModel
@using MedalRunner.Models
@{
    int charId;
    if (Model.Character != null)
    {
        charId = Model.Character.Id;
    }
    else
    {
        charId = 0;
    }

    int SlotId(int slot)
    {
        if (Model.EquippedSlots.TryGetValue(slot, out var item))
        {
            return item.Id;
        }
        return 0;
    }

    string SlotImg(int slot, string fallback)
    {
        if (Model.EquippedSlots.TryGetValue(slot, out var slotItem))
        {
            return slotItem.ImageUrl;
        }
        return fallback;
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/app/specificCharacter.css" />
}

<div class="character-container">
    <div class="top-container">
        <div class="top-left">
            <div class="top-left-top">
                <p class="char-name">@Model.Character?.Name</p>
                <div class="top-l-t-one">
                    <p>@(Model.Character?.Gear?.Count > 0 ? Model.Character.Gear.Sum(i => i.ItemLevel) / Model.Character.Gear.Count : 0) ilvl</p>
                    <p>@Model.Character?.Race</p>
                </div>
                <div class="top-l-t-two">
                    <p>@Model.Character?.CharacterClass</p>
                    <p>Spec @Model.Character?.Specialization</p>
                </div>
            </div>
            <div class="top-left-bottom">
                <p class="top-l-b-attributes">Attributes</p>
                <div class="top-l-b-stat-container">
                    <div class="stat-container">
                        <p class="top-l-stat">Stamina</p>
                        <p>XXXX</p>
                    </div>
                    <div class="stat-container">
                        <p class="top-l-stat">Strength</p>
                        <p>XXXX</p>
                    </div>
                    <div class="stat-container">
                        <p class="top-l-stat">Intellect</p>
                        <p>XXXX</p>
                    </div>
                    <div class="stat-container">
                        <p class="top-l-stat">Agility</p>
                        <p>XXXX</p>
                    </div>
                </div>

            </div>
        </div>
        <div class="top-right">
            <div class="three-slots">
                @* Head (slot 1) *@
                <a asp-page="/App/Character/Change" asp-route-characterId="@charId" asp-route-slot="@((int)Item.GearSlot.Head)" asp-route-itemId="@SlotId((int)Item.GearSlot.Head)">
                    <img class="item-slot" src="@SlotImg((int)Item.GearSlot.Head, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/head.png")" alt="Head" />
                </a>
                <p>@Model.Character?.Name</p>
                @* Neck (slot 2) *@
                <a asp-page="/App/Character/Change" asp-route-characterId="@charId" asp-route-slot="@((int)Item.GearSlot.Neck)" asp-route-itemId="@SlotId((int)Item.GearSlot.Neck)">
                    <img class="item-slot" src="@SlotImg((int)Item.GearSlot.Neck, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/neck.png")" alt="Neck" />
                </a>
            </div>
            <div class="two-slots">
                @* Shoulders (slot 3) *@
