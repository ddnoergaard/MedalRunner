@page "/character/{id:int}"
@model MedalRunner.Pages.App.Character.DetailsModel

@section Styles {
    <link rel="stylesheet" href="~/css/app/specificCharacter.css" />
}

<div class="character-container">
    <div class="top-container">
        <div class="top-left">
            <div class="top-left-top">
                <p class="char-name">@Model.Character?.Name</p>
                <div class="top-l-t-one">
                    <p>Ilvl: @Model.CalcILevel</p>
                    <p>@Model.Character?.Race</p>
                </div>
                <div class="top-l-t-two">
                    <p>@Model.Character?.CharacterClass</p>
                    <p>Spec @Model.specName</p>
                </div>
            </div>
            <div class="top-left-bottom">
                <p class="top-l-b-attributes">Attributes</p>
                <div class="top-l-b-stat-container">
                    <div class="stat-container">
                        <p class="top-l-stat">Stamina</p>
                        <p>@Model.CalcStamina</p>
                    </div>
                    <div class="stat-container">
                        <p class="top-l-stat">Strength</p>
                        <p>@Model.CalcStrength</p>
                    </div>
                    <div class="stat-container">
                        <p class="top-l-stat">Intellect</p>
                        <p>@Model.CalcIntellect</p>
                    </div>
                    <div class="stat-container">
                        <p class="top-l-stat">Agility</p>
                        <p>@Model.CalcAgility</p>
                    </div>
                </div>

            </div>
        </div>
        <div class="top-right">
            <div class="one-slot">
                @* Head (slot 1) *@
                <a asp-page="/App/Character/Change"
                   asp-route-characterId="@Model.Character.Id"
                   asp-route-slot="1"
                   asp-route-itemId="@Model.GetSlotItemId(1)">
                    <img class="item-slot" src="@Model.GetSlotImageUrl(1)" alt="Head" />
                </a>
            </div>
            <div class="two-slots">
                @* Shoulders (slot 3) *@
                <a asp-page="/App/Character/Change"
                   asp-route-characterId="@Model.Character.Id"
                   asp-route-slot="3"
                   asp-route-itemId="@Model.GetSlotItemId(3)">
                    <img class="item-slot" src="@Model.GetSlotImageUrl(3)" alt="Shoulders" />
                </a>
                @* Back (slot 4) *@
                <a asp-page="/App/Character/Change"
                   asp-route-characterId="@Model.Character.Id"
                   asp-route-slot="4"
                   asp-route-itemId="@Model.GetSlotItemId(4)">
                    <img class="item-slot" src="@Model.GetSlotImageUrl(4)" alt="Back" />
                </a>
            </div>
            <div class="two-slots">
                @* Chest (slot 5) *@
                <a asp-page="/App/Character/Change"
                   asp-route-characterId="@Model.Character.Id"
                   asp-route-slot="5"
                   asp-route-itemId="@Model.GetSlotItemId(5)">
                    <img class="item-slot" src="@Model.GetSlotImageUrl(5)" alt="Chest" />
                </a>
                @* Wrists (slot 6) *@
                <a asp-page="/App/Character/Change"
                   asp-route-characterId="@Model.Character.Id"
                   asp-route-slot="6"
                   asp-route-itemId="@Model.GetSlotItemId(6)">
                    <img class="item-slot" src="@Model.GetSlotImageUrl(6)" alt="Wrists" />
                </a>
            </div>
            <div class="two-slots">
                @* Hands (slot 7) *@
                <a asp-page="/App/Character/Change"
                   asp-route-characterId="@Model.Character.Id"
                   asp-route-slot="7"
                   asp-route-itemId="@Model.GetSlotItemId(7)">
                    <img class="item-slot" src="@Model.GetSlotImageUrl(7)" alt="Hands" />
                </a>
                @* Belt (slot 8) *@
                <a asp-page="/App/Character/Change"
                   asp-route-characterId="@Model.Character.Id"
                   asp-route-slot="8"
                   asp-route-itemId="@Model.GetSlotItemId(8)">
                    <img class="item-slot" src="@Model.GetSlotImageUrl(8)" alt="Belt" />
                </a>
            </div>
            <div class="two-slots">
                @* Legs (slot 9) *@
                <a asp-page="/App/Character/Change"
                   asp-route-characterId="@Model.Character.Id"
                   asp-route-slot="9"
                   asp-route-itemId="@Model.GetSlotItemId(9)">
                    <img class="item-slot" src="@Model.GetSlotImageUrl(9)" alt="Legs" />
                </a>
                @* Feet (slot 10) *@
                <a asp-page="/App/Character/Change"
                   asp-route-characterId="@Model.Character.Id"
                   asp-route-slot="10"
                   asp-route-itemId="@Model.GetSlotItemId(10)">
                    <img class="item-slot" src="@Model.GetSlotImageUrl(10)" alt="Feet" />
                </a>
            </div>
            <div class="two-slots">
                @* Ring (slot 11) *@
                <a asp-page="/App/Character/Change"
                   asp-route-characterId="@Model.Character.Id"
                   asp-route-slot="11"
                   asp-route-itemId="@Model.GetSlotItemId(11)">
                    <img class="item-slot" src="@Model.GetSlotImageUrl(11)" alt="Ring" />
                </a>
                @* Trinket (slot 13) *@
                <a asp-page="/App/Character/Change"
                   asp-route-characterId="@Model.Character.Id"
                   asp-route-slot="13"
                   asp-route-itemId="@Model.GetSlotItemId(13)">
                    <img class="item-slot" src="@Model.GetSlotImageUrl(13)" alt="Trinket" />
                </a>
            </div>
            <div class="four-slots">
                @* Tabard (slot 0) *@
                <a asp-page="/App/Character/Change"
                   asp-route-characterId="@Model.Character.Id"
                   asp-route-slot="0"
                   asp-route-itemId="@Model.GetSlotItemId(0)">
                    <img class="item-slot" src="@Model.GetSlotImageUrl(0)" alt="Tabard" />
                </a>
                @* MainHand (slot 15) *@
                <a asp-page="/App/Character/Change"
                   asp-route-characterId="@Model.Character.Id"
                   asp-route-slot="15"
                   asp-route-itemId="@Model.GetSlotItemId(15)">
                    <img class="item-slot" src="@Model.GetSlotImageUrl(15)" alt="Main Hand" />
                </a>
                @* OffHand (slot 16) *@
                <a asp-page="/App/Character/Change"
                   asp-route-characterId="@Model.Character.Id"
                   asp-route-slot="16"
                   asp-route-itemId="@Model.GetSlotItemId(16)">
                    <img class="item-slot" src="@Model.GetSlotImageUrl(16)" alt="Off Hand" />
                </a>
                @* Placeholder for 4th slot in row *@
                <a><img class="item-slot" src="https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png" alt=""></a>
            </div>
        </div>
    </div>
    <div class="bottom-container">
        <div class="bis-select-container">
            <form class="bis-select" asp-page-handler="Bis" method="post"><input type="hidden" name="id" value="@Model.Character.Id" /><button type="submit">BIS</button></form>
            <form class="bis-select" asp-page-handler="Bis" method="post"><input type="hidden" name="id" value="@Model.Character.Id" /><button type="submit">REGULAR BIS</button></form>
            <form class="bis-select" asp-page-handler="Bis" method="post"><input type="hidden" name="id" value="@Model.Character.Id" /><button type="submit">DAD GAMER BIS</button></form>
        </div>
        <div class="tabel-container">
            <table>
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (Item i in Model.DisplayList)
                    {
                        <tr>
                            <td><img src="@i.ImageUrl"></img></td>
                            <td>@i.Name</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p style="place-self:center;">@ViewData["display-list-empty-msg"]</p>
        </div>
    </div>
</div>
