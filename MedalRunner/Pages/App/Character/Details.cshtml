                @* Trinket2 (slot 14) *@
                <a asp-page="/App/Character/Change" asp-route-characterId="@charId" asp-route-slot="@((int)Item.GearSlot.Trinket2)" asp-route-itemId="@SlotId((int)Item.GearSlot.Trinket2)">
                    <img class="item-slot" src="@SlotImg((int)Item.GearSlot.Trinket2, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/trinket.png")" alt="Trinket 2" />
                </a>
            </div>
            <div class="four-slots">
                @* Tabard (slot 0) *@
                <a asp-page="/App/Character/Change" asp-route-characterId="@charId" asp-route-slot="@((int)Item.GearSlot.Tabard)" asp-route-itemId="@SlotId((int)Item.GearSlot.Tabard)">
                    <img class="item-slot" src="@SlotImg((int)Item.GearSlot.Tabard, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/tabard.png")" alt="Tabard" />
                </a>
                @* MainHand (slot 15) *@
                <a asp-page="/App/Character/Change" asp-route-characterId="@charId" asp-route-slot="@((int)Item.GearSlot.MainHand)" asp-route-itemId="@SlotId((int)Item.GearSlot.MainHand)">
                    <img class="item-slot" src="@SlotImg((int)Item.GearSlot.MainHand, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/1h-sword.png")" alt="Main Hand" />
                </a>
                @* OffHand (slot 16) *@
                <a asp-page="/App/Character/Change" asp-route-characterId="@charId" asp-route-slot="@((int)Item.GearSlot.OffHand)" asp-route-itemId="@SlotId((int)Item.GearSlot.OffHand)">
                    <img class="item-slot" src="@SlotImg((int)Item.GearSlot.OffHand, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/offhand.png")" alt="Off Hand" />
                </a>
                @* Placeholder for 4th slot in row *@
                <a><img class="item-slot" src="https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png" alt=""></a>
            </div>
        </div>
    </div>
    <div class="bottom-container">
        <div class="bis-select-container">
            <form class="bis-select" asp-page-handler="Bis" method="post"><button type="submit">BIS</button></form>
            <form class="bis-select" asp-page-handler="RegularBis" method="post"><button type="submit">REGULAR BIS</button></form>
            <form class="bis-select" asp-page-handler="DGBis" method="post"><button type="submit">DAD GAMER BIS</button></form>
        </div>
        <div class="tabel-container">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Drop by</th>
                        <th>Dungeon</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Shoulders</td>
                        <td>Axel</td>
                        <td>The school</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>