                    <img class="item-slot" src="@SlotImg((int)Item.GearSlot.Shoulders, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/shoulders.png")" alt="Shoulders" />
                </a>
                @* Back (slot 4) *@
                <a asp-page="/App/Character/Change" asp-route-characterId="@charId" asp-route-slot="@((int)Item.GearSlot.Back)" asp-route-itemId="@SlotId((int)Item.GearSlot.Back)">
