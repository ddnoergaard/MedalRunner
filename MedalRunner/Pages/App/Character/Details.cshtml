@page "{id:int}"
@model MedalRunner.Pages.App.Character.DetailsModel
@using MedalRunner.Models
@{
    // Helper: returns the item ID for the given slot, or 0 if nothing is equipped
    int SlotId(int slot) => Model.EquippedSlots.TryGetValue(slot, out var item) ? item.Id : 0;
    string SlotImg(int slot, string fallback) => Model.EquippedSlots.TryGetValue(slot, out var item) ? item.ImageUrl : fallback;
}

@section Styles {
    <link rel="stylesheet" href="~/css/app/specificCharacter.css" />
}

<div class="character-container">
    <div class="top-container">
        <div class="top-left">
            <div class="top-left-top">
                <p class="char-name">@Model.Character?.Name</p>
                <div class="top-l-t-one">
                    <p>@Model.Character?.Gear?.Sum(i => i.ItemLevel) / (Model.Character?.Gear?.Count > 0 ? Model.Character.Gear.Count : 1) ilvl</p>
                    <p>@Model.Character?.Race</p>
                </div>
                <div class="top-l-t-two">
                    <p>@Model.Character?.CharacterClass</p>
                    <p>Spec @Model.Character?.Specialization</p>
                </div>
            </div>
            <div class="top-left-bottom">
                <p class="top-l-b-attributes">Attributes</p>
                <div class="top-l-b-stat-container">
                    <div class="stat-container">
                        <p class="top-l-stat">Stamina</p>
                        <p>XXXX</p>
                    </div>
                    <div class="stat-container">
                        <p class="top-l-stat">Strength</p>
                        <p>XXXX</p>
                    </div>
                    <div class="stat-container">
                        <p class="top-l-stat">Intellect</p>
                        <p>XXXX</p>
                    </div>
                    <div class="stat-container">
                        <p class="top-l-stat">Agility</p>
                        <p>XXXX</p>
                    </div>
                </div>

            </div>
        </div>
        <div class="top-right">
            <div class="three-slots">
                @* Head (slot 1) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Head)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Head, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Head"></a>
                <p>@Model.Character?.Name</p>
                @* Neck (slot 2) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Neck)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Neck, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Neck"></a>
            </div>
            <div class="two-slots">
                @* Shoulders (slot 3) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Shoulders)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Shoulders, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Shoulders"></a>
                @* Back (slot 4) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Back)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Back, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Back"></a>
            </div>
            <div class="two-slots">
                @* Chest (slot 5) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Chest)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Chest, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Chest"></a>
                @* Wrists (slot 6) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Wrists)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Wrists, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Wrists"></a>
            </div>
            <div class="two-slots">
                @* Hands (slot 7) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Hands)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Hands, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Hands"></a>
                @* Belt (slot 8) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Belt)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Belt, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Belt"></a>
            </div>
            <div class="two-slots">
                @* Legs (slot 9) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Legs)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Legs, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Legs"></a>
                @* Feet (slot 10) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Feet)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Feet, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Feet"></a>
            </div>
            <div class="two-slots">
                @* Ring1 (slot 11) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Ring1)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Ring1, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Ring 1"></a>
                @* Ring2 (slot 12) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Ring2)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Ring2, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Ring 2"></a>
            </div>
            <div class="two-slots">
                @* Trinket1 (slot 13) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Trinket1)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Trinket1, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Trinket 1"></a>
                @* Trinket2 (slot 14) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Trinket2)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Trinket2, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Trinket 2"></a>
            </div>
            <div class="four-slots">
                @* Tabard (slot 0) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.Tabard)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.Tabard, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Tabard"></a>
                @* MainHand (slot 15) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.MainHand)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.MainHand, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Main Hand"></a>
                @* OffHand (slot 16) *@
                <a asp-page="/App/Character/Change" asp-route-itemId="@SlotId((int)Item.GearSlot.OffHand)"><img class="item-slot" src="@SlotImg((int)Item.GearSlot.OffHand, "https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png")" alt="Off Hand"></a>
                @* Placeholder for 4th slot in row *@
                <a><img class="item-slot" src="https://cdn.jsdelivr.net/gh/ddnoergaard/mop-assets@main/items/feet.png" alt=""></a>
            </div>
        </div>
    </div>
    <div class="bottom-container">
        <div class="bis-select-container">
            <form class="bis-select" asp-page-handler="Bis" method="post"><button type="submit">BIS</button></form>
            <form class="bis-select" asp-page-handler="RegularBis" method="post"><button type="submit">REGULAR BIS</button></form>
            <form class="bis-select" asp-page-handler="DGBis" method="post"><button type="submit">DAD GAMER BIS</button></form>
        </div>
        <div class="tabel-container">
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Drop by</th>
                        <th>Dungeon</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Shoulders</td>
                        <td>Axel</td>
                        <td>The school</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>