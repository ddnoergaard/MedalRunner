@page "{characterId:int}/{slot:int}/{itemId:int}"
@model MedalRunner.Pages.App.Character.ChangeModel
@using MedalRunner.Models

@section Styles {
    <link rel="stylesheet" href="~/css/app/change.css" />
}

<div class="change-page">

    <h2 class="change-title">Compare &mdash; @((Item.GearSlot)Model.CurrentSlot)</h2>

    <div class="compare-container">

        @* Left: currently equipped item *@
        @if (Model.EquippedItem == null)
        {
            <div class="compare-card equipped empty">
                <p class="empty-hint">No item equipped in this slot</p>
            </div>
        }
        else
        {
            <div class="compare-card equipped">
                <div class="card-header">
                    <img src="@Model.EquippedItem.ImageUrl" alt="@Model.EquippedItem.Name" class="item-image" />
                    <span class="item-name">@Model.EquippedItem.Name</span>
                    <span class="item-meta">ilvl @Model.EquippedItem.ItemLevel, @Model.EquippedItem.Rarity, @Model.EquippedItem.Difficulty</span>
                </div>
                <div class="card-stats">
                    @if (Model.EquippedItem.Armor > 0)
                    {
                        <p>Armor: @Model.EquippedItem.Armor</p>
                    }
                    @if (Model.EquippedItem.Stamina > 0)
                    {
                        <p>Stamina: @Model.EquippedItem.Stamina</p>
                    }
                    @if (Model.EquippedItem.Strength > 0)
                    {
                        <p>Strength: @Model.EquippedItem.Strength</p>
                    }
                    @if (Model.EquippedItem.Agility > 0)
                    {
                        <p>Agility: @Model.EquippedItem.Agility</p>
                    }
                    @if (Model.EquippedItem.Intellect > 0)
                    {
                        <p>Intellect: @Model.EquippedItem.Intellect</p>
                    }
                    @if (Model.EquippedItem.Spirit > 0)
                    {
                        <p>Spirit: @Model.EquippedItem.Spirit</p>
                    }
                    @if (Model.EquippedItem.Haste > 0)
                    {
                        <p>Haste: @Model.EquippedItem.Haste</p>
                    }
                    @if (Model.EquippedItem.Crit > 0)
                    {
                        <p>Crit: @Model.EquippedItem.Crit</p>
                    }
                    @if (Model.EquippedItem.Mastery > 0)
                    {
                        <p>Mastery: @Model.EquippedItem.Mastery</p>
                    }
                    @if (Model.EquippedItem.Dodge > 0)
                    {
                        <p>Dodge: @Model.EquippedItem.Dodge</p>
                    }
                    @if (Model.EquippedItem.Parry > 0)
                    {
                        <p>Parry: @Model.EquippedItem.Parry</p>
                    }
                    @if (Model.EquippedItem.Hit > 0)
                    {
                        <p>Hit: @Model.EquippedItem.Hit</p>
                    }
                    @if (Model.EquippedItem.Expertise > 0)
                    {
                        <p>Expertise: @Model.EquippedItem.Expertise</p>
                    }
                    @if (Model.EquippedItem.MinDamage > 0)
                    {
                        <p>Damage: @Model.EquippedItem.MinDamage &ndash; @Model.EquippedItem.MaxDamage</p>
                    }
                </div>
                <div class="card-footer">
                    @if (!string.IsNullOrEmpty(Model.EquippedItem.DropBoss))
                    {
                        <p class="item-source">@Model.EquippedItem.DropBoss &middot; @Model.EquippedItem.DropDungeon</p>
                    }
                </div>
            </div>
        }

        @* Right: comparison item, empty until one is selected *@
        @if (Model.CompareItem == null)
        {
            <div class="compare-card compare empty">
                <p class="empty-hint">Select an item below to compare</p>
            </div>
        }
        else
        {
            <div class="compare-card compare">
                <div class="card-header">
                    <img src="@Model.CompareItem.ImageUrl" alt="@Model.CompareItem.Name" class="item-image" />
                    <span class="item-name">@Model.CompareItem.Name</span>
                    <span class="item-meta">ilvl @Model.CompareItem.ItemLevel, @Model.CompareItem.Rarity, @Model.CompareItem.Difficulty</span>
                </div>
                <div class="card-stats">
                    @if (Model.CompareItem.Armor > 0)
                    {
                        <p>Armor: @Model.CompareItem.Armor</p>
                    }
                    @if (Model.CompareItem.Stamina > 0)
                    {
                        <p>Stamina: @Model.CompareItem.Stamina</p>
                    }
                    @if (Model.CompareItem.Strength > 0)
                    {
                        <p>Strength: @Model.CompareItem.Strength</p>
                    }
                    @if (Model.CompareItem.Agility > 0)
                    {
                        <p>Agility: @Model.CompareItem.Agility</p>
                    }
                    @if (Model.CompareItem.Intellect > 0)
                    {
                        <p>Intellect: @Model.CompareItem.Intellect</p>
                    }
                    @if (Model.CompareItem.Spirit > 0)
                    {
                        <p>Spirit: @Model.CompareItem.Spirit</p>
                    }
                    @if (Model.CompareItem.Haste > 0)
                    {
                        <p>Haste: @Model.CompareItem.Haste</p>
                    }
                    @if (Model.CompareItem.Crit > 0)
                    {
                        <p>Crit: @Model.CompareItem.Crit</p>
                    }
                    @if (Model.CompareItem.Mastery > 0)
                    {
                        <p>Mastery: @Model.CompareItem.Mastery</p>
                    }
                    @if (Model.CompareItem.Dodge > 0)
                    {
                        <p>Dodge: @Model.CompareItem.Dodge</p>
                    }
                    @if (Model.CompareItem.Parry > 0)
                    {
                        <p>Parry: @Model.CompareItem.Parry</p>
                    }
                    @if (Model.CompareItem.Hit > 0)
                    {
                        <p>Hit: @Model.CompareItem.Hit</p>
                    }
                    @if (Model.CompareItem.Expertise > 0)
                    {
                        <p>Expertise: @Model.CompareItem.Expertise</p>
                    }
                    @if (Model.CompareItem.MinDamage > 0)
                    {
                        <p>Damage: @Model.CompareItem.MinDamage &ndash; @Model.CompareItem.MaxDamage</p>
                    }
                </div>
                <div class="card-footer">
                    @if (!string.IsNullOrEmpty(Model.CompareItem.DropBoss))
                    {
                        <p class="item-source">@Model.CompareItem.DropBoss &middot; @Model.CompareItem.DropDungeon</p>
                    }
                </div>
            </div>
        }

    </div>

    @* Item picker list *@
    <div class="item-picker">
        <h3>Available items</h3>
        @if (!Model.SlotItems.Any())
        {
            <p>No other items found for this slot.</p>
        }
        else
        {
            <form method="post" asp-route-characterId="@Model.RouteCharacterId"
                               asp-route-slot="@Model.CurrentSlot"
                               asp-route-itemId="@(Model.EquippedItem != null ? Model.EquippedItem.Id : 0)">
                <ul class="item-list">
                    @foreach (var item in Model.SlotItems)
                    {
                        if (Model.CompareItem != null && Model.CompareItem.Id == item.Id)
                        {
                            <li class="item-list-entry selected">
                                <button type="submit" name="SelectedItemId" value="@item.Id" class="item-list-btn">
                                    <img src="@item.ImageUrl" alt="@item.Name" class="item-thumb" />
                                    <span class="item-list-name">@item.Name</span>
                                    <span class="item-list-meta">ilvl @item.ItemLevel &middot; @item.Rarity</span>
                                </button>
                            </li>
                        }
                        else
                        {
                            <li class="item-list-entry">
                                <button type="submit" name="SelectedItemId" value="@item.Id" class="item-list-btn">
                                    <img src="@item.ImageUrl" alt="@item.Name" class="item-thumb" />
                                    <span class="item-list-name">@item.Name</span>
                                    <span class="item-list-meta">ilvl @item.ItemLevel &middot; @item.Rarity</span>
                                </button>
                            </li>
                        }
                    }
                </ul>
                <div class="action-buttons">
                    <input type="hidden" name="newItemId" value="@(Model.CompareItem != null ? Model.CompareItem.Id : 0)" />
                    <button type="submit" asp-page-handler="Cancel" class="btn-cancel">Cancel</button>
                    <button type="submit" asp-page-handler="Accept" class="btn-accept">Accept</button>
                </div>
            </form>
        }
    </div>

</div>
