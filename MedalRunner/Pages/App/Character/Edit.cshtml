@page "{id:int}"
@model MedalRunner.Pages.App.Character.EditModel
@{
}

<form method="post">
    @* <div class="form-group">
        <label asp-for="Character.Id" class="control-labele"></label>
        <input asp-for="Character.Id" class="form-control" readonly="@true" />
    </div> *@
    <input type="hidden">@Model.Character.Id</input>
    <div class=" form-group">
        <label asp-for="Character.Name" class="control-lable"></label>
        <input style="color:black" asp-for="Character.Name" class="form-control" />
        <span asp-validation-for="Character.Name" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Character.Race" class="control-lable"></label>
        <select name="Character.Race" id="Character.Race" style="color:black">
            <option style="color:black" value="null">Please select a Race</option>
            <option style="color:black" value="Human">Human</option>
            <option style="color:black" value="Dwarf">Dwarf</option>
            <option style="color:black" value="Gnome">Gnome</option>
            <option style="color:black" value="Night Elf">Night Elf</option>
            <option style="color:black" value="Drenei">Drenei</option>
            <option style="color:black" value="Worgen">Worgen</option>
            <option style="color:black" value="Pandaren">Pandaren</option>
            <option style="color:black" value="Orc">Orc</option>
            <option style="color:black" value="Troll">Troll</option>
            <option style="color:black" value="Tauren">Tauren</option>
            <option style="color:black" value="Undead">Undead</option>
            <option style="color:black" value="Blood Elf">Blood Elf</option>
            <option style="color:black" value="Goblin">Goblin</option>
        </select>
        <span asp-validation-for="Character.Race" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Character.CharacterClass" class="control-lable"></label>
        <select style="color:black" name="Character.CharacterClass" id="Character.CharacterClass">
            <option style="color:black" value="null">Please select a Class</option>
            <option style="color:black" value="1">Death Knight</option>
            <option style="color:black" value="2">Druid</option>
            <option style="color:black" value="3">Hunter</option>
            <option style="color:black" value="4">Mage</option>
            <option style="color:black" value="5">Monk</option>
            <option style="color:black" value="6">Paladin</option>
            <option style="color:black" value="7">Priest</option>
            <option style="color:black" value="8">Rouge</option>
            <option style="color:black" value="9">Shaman</option>
            <option style="color:black" value="10">Warlock</option>
            <option style="color:black" value="11">Warrior</option>
        </select>
        <span asp-validation-for="Character.CharacterClass" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Character.Specialization" class="control-lable"></label>
        <select style="color:black" name="Character.Specialization" id="Character.Specialization">
            <option style="color:black" value="null">Please select a Specialization</option>
            <option style="color:black" value="1">Blood</option>
            <option style="color:black" value="2">Frost</option>
            <option style="color:black" value="3">Unholy</option>
            <option style="color:black" value="4">Balance</option>
            <option style="color:black" value="5">Feral</option>
            <option style="color:black" value="6">Guardian</option>
            <option style="color:black" value="7">Restoration-Druid</option>
            <option style="color:black" value="8">Beast Mastery</option>
            <option style="color:black" value="9">Marksmanship</option>
            <option style="color:black" value="10">Survival</option>
            <option style="color:black" value="11">Arcane</option>
            <option style="color:black" value="12">Fire</option>
            <option style="color:black" value="13">Frost</option>
            <option style="color:black" value="14">Brewmaster</option>
            <option style="color:black" value="15">Mistweaver</option>
            <option style="color:black" value="16">Windwalker</option>
            <option style="color:black" value="17">Holy-Paladin</option>
            <option style="color:black" value="18">Protection-Paladin</option>
            <option style="color:black" value="19">Retrebution</option>
            <option style="color:black" value="20">Discipline</option>
            <option style="color:black" value="21">Holy-Priest</option>
            <option style="color:black" value="22">Shadow</option>
            <option style="color:black" value="23">Assasination</option>
            <option style="color:black" value="24">Outlaw</option>
            <option style="color:black" value="25">Subtlety</option>
            <option style="color:black" value="26">Elemental</option>
            <option style="color:black" value="27">Enhancement</option>
            <option style="color:black" value="28">Restoration-Shaman</option>
            <option style="color:black" value="29">Affliction</option>
            <option style="color:black" value="30">Demonology</option>
            <option style="color:black" value="31">Destruction</option>
            <option style="color:black" value="32">Arms</option>
            <option style="color:black" value="33">Fury</option>
            <option style="color:black" value="34">Protection-Warrior</option>
        </select>
        <span asp-validation-for="Character.Specialization" class="text-danger"></span>
    </div>

    

    <p>
        <div class="form-group">
            <button style="color:black" type="submit" asp-route-id="@Model.Character.Id" value="Update" class="btn btn-danger" />
        </div>
    </p>
</form>