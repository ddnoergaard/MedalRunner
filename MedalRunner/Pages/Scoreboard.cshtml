@page
@model MedalRunner.Pages.ScoreboardModel
@{
}

@section Styles {
    <link href="/css/public/scoreboard.css" rel="stylesheet" />
}

<div class="scoreboard-container">
    <div class="section-one">
        <h1>Scoreboards</h1>
        <p>Track and compare performance across all players and dungeons.</p>
        <p>Use the filters below to narrow down results by player, dungeon, difficulty, or time period.</p>
    </div>
    <div class="section-two">
        <form method="get" asp-page-handler="filter">
            <div>
                <select name="DungeonName">
                    <option value="null">Choose a dungeon</option>
                    <option value="2">Temple of the Jade Serpent</option>
                    <option value="3">Stormstout Brewery</option>
                    <option value="4">Shado-Pan Monastery</option>
                    <option value="5">Siege of Niuzao Temple</option>
                    <option value="6">Gate of the Setting Sun</option>
                    <option value="7">Mogu'shan Palace</option>
                    <option value="8">Scholomance</option>
                    <option value="9">Scarlet Halls</option>
                    <option value="10">Scarlet Monastery</option>
                </select>
                <input type="text" placeholder="Character name">
            </div>
            <button type="submit">Search</button>
        </form>
    </div>
    <div class="section-three">
        <table>
            <thead>
                <tr>
                    <th>Dungeon</th>
                    <th>Name</th>
                    <th>Score</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.DisplayScoreboardList.Count > 0)
                {
                    @foreach (Models.Scoreboard scoreboard in Model.DisplayScoreboardList)
                    {
                        <tr>
                            <td>@scoreboard.Dungeon.Name</td>
                            <td>@scoreboard.Name</td>
                            <td>@scoreboard.Score</td>
                            <td>@scoreboard.RunDate</td>
                        </tr>
                    }
                } else
                {
                    @foreach (Models.Scoreboard scoreboard in Model.ScoreboardList)
                    {
                        <tr>
                            <td>@scoreboard.Dungeon.Name</td>
                            <td>@scoreboard.Name</td>
                            <td>@scoreboard.Score</td>
                            <td>@scoreboard.RunDate</td>
                        </tr>
                    }
                }
                
            </tbody>
        </table>
        <p>@ViewData["scoreboard-error-msg"]</p>
    </div>
</div>